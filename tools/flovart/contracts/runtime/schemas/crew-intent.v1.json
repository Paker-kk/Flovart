{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flovart.local/schemas/runtime/crew-intent.v1.json",
  "title": "CrewIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intentId", "idempotencyKey", "projectId", "goal", "scope", "constraints", "status", "createdAt"],
  "properties": {
    "intentId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace"],
      "properties": {
        "workspace": { "enum": ["workflow"] },
        "selectedObjectIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSideEffect"],
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxSideEffect": { "enum": ["read-only", "draft-only", "local-artifact", "provider-paid", "publish-external", "irreversible"] },
        "allowedCapabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxTokens": { "type": "integer", "minimum": 0 },
            "maxWallClockMs": { "type": "integer", "minimum": 0 },
            "maxReads": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredOutputs": {
          "type": "array",
          "items": { "enum": ["changeset", "receipt", "task"] }
        }
      }
    },
    "director": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "hostKind": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["accepted", "inspecting", "planning", "executing", "completed", "partial", "failed", "waiting", "cancelled", "interrupted"] },
    "changeSetId": { "type": "string", "minLength": 1 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 }
  }
}