{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flovart.local/schemas/runtime/crew-receipt.v1.json",
  "title": "CrewReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intentId", "status", "eventCursor", "commands"],
  "properties": {
    "intentId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "partial", "failed", "waiting", "cancelled", "interrupted"] },
    "changeSetId": { "type": "string", "minLength": 1 },
    "draftVersion": { "type": "integer", "minimum": 1 },
    "affectedObjectIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "taskRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "kind"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "waiting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "objectIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "changeSetId": { "type": "string", "minLength": 1 },
          "affectedNodeIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "affectedConnectionIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "draftVersion": { "type": "integer", "minimum": 1 },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "integer", "minimum": 0 },
        "reads": { "type": "integer", "minimum": 0 }
      }
    },
    "eventCursor": { "type": "integer", "minimum": 0 },
    "completedAt": { "type": "string", "minLength": 1 }
  }
}