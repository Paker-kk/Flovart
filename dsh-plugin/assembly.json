{
  "$schema": "https://flovart.local/schemas/dsh-plugin/assembly.v1.json",
  "schemaVersion": "1",
  "pluginId": "com.flovart.dsh-plugin",
  "pluginVersion": "0.1.0",
  "compatibleSets": [
    {
      "setId": "flovart-2026-08-rc8",
      "deepseekHarness": "0.1.0-rc.8",
      "deepseekHarnessCommit": "141eb6f",
      "node": "^22.19.0 || >=24.0.0",
      "flovartRuntime": ">=0.3.2",
      "flovartWebUI": ">=0.3.2",
      "operationSkill": "",
      "protocol": {
        "channel": "flovart-workspace-command",
        "version": 1
      }
    }
  ],
  "entrypoints": {
    "bundle": {
      "package": "@flovart/dsh-plugin",
      "patch": "./cordis.patch.yml",
      "clientEntry": "./client",
      "rowId": "flovart"
    },
    "workflowView": {
      "kind": "native-conversation-view",
      "slot": "conversation.view",
      "surface": "production",
      "badges": ["waiting", "error", "artifacts"],
      "briefLedStart": true,
      "autoWorkspace": true,
      "sidebarEntry": false,
      "iframe": false,
      "workspaceProxyPath": "/flovart-workspace"
    },
    "hostTools": {
      "kind": "cli-derivation",
      "commandList": "flovart command.list --json",
      "commandSchema": "flovart command.schema --command {command} --json",
      "bootstrap": "flovart director.bind --agent-identity deepseek-harness --session-id {sessionId} --project-id {projectId} --json"
    }
  },
  "privacy": {
    "sessionBindingOnly": true,
    "noChatMirror": true,
    "noProviderSecrets": true,
    "noLongTermTokensInUrl": true,
    "workspaceTokenHostOnly": true
  },
  "degradation": {
    "pluginDisabled": "Operation Skill + CLI",
    "independentWindow": false
  }
}
